APP_NAME="ForgeAuth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=forgeauth
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="security@forgeauth.dev"
MAIL_FROM_NAME="${APP_NAME}"
